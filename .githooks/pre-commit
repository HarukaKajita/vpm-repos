#!/bin/sh
# 生成物: この内容はテンプレートリポジトリ UnityTemplate_2022_3_22f1 から配布されたコピーです。
# 編集はテンプレート側で行い、scripts/distribute_standard.py で再配布してください。
# source: UnityTemplate_2022_3_22f1/scripts/templates/githooks-pre-commit
# source-sha256: 673a919520e1828962d0cbd090c14e0c030d2476be327388dc0c2febad7efbc0
# テンプレート GUID の流用と、スキルミラーの drift を commit 前に止める。
#
# **同期はしない（index も working tree も変更しない）。** 検査だけを行い、ずれていれば
# commit を止めて修復コマンドを案内する。commit の途中で index を書き換えると
# `git add -p` の部分ステージの意図と食い違い、`git commit -a` は未追跡ファイルを拾わないため、
# 「hook が直したつもりで実際は不整合が commit される」状態を作りうる（2026-07-29 設計判断）。
#
# 自動でミラーさせる層は .claude/settings.json の PostToolUse フック（正本を編集した直後に同期）。
# 最終的な保証は CI（.github/workflows/pipeline-verify.yml の標準準拠検査）が持つ。
# この hook はその中間にある、手元での早期検出。
#
# **判定は標準準拠検査（verify_repo_guide.py）に一本化し、この hook は受け持つ検査の指摘を
# 取り出すだけにする。** 以前はテンプレート正本の .meta を作業ツリーの find で探していたが、
# テンプレートが VRChat 向けの構成になった時点で、.gitignore で無視される VPM パッケージの展開物・
# MCP for Unity の Roslyn と、意図して追跡している第三者パッケージ（vpm-resolver）の .meta まで拾い、
# テンプレートで一切 commit できなくなった（2026-09-14 修正）。同じ規則を 2 か所に書くと
# 片方だけが古くなるので、検査 6 の判定（git がコミットしうる .meta・自リポジトリ所有の package だけ）を使う。
#
# 有効化（クローンごとに 1 回。core.hooksPath は git 追跡できないため）:
#   git config core.hooksPath .githooks
#
# 注意: `git commit --no-verify` で素通りできる。だからこの hook を唯一の保証にはしない。

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f pipeline/repo.json ]; then
  exit 0
fi

# この hook が受け持つ検査は 2 つ。どちらも対象でないリポジトリは Python を探す前に抜ける。
#   - テンプレート正本（role: standard）の .meta 混入 = 検査 6
#   - skillSync を宣言したリポジトリのスキルミラー drift = 検査 12
is_standard_template=0
if grep -Eq '"role"[[:space:]]*:[[:space:]]*"standard"' pipeline/repo.json 2>/dev/null; then
  is_standard_template=1
fi
has_skill_sync=0
if grep -q '"skillSync"' pipeline/repo.json 2>/dev/null; then
  has_skill_sync=1
fi
if [ "$is_standard_template" -eq 0 ] && [ "$has_skill_sync" -eq 0 ]; then
  exit 0
fi

if [ ! -f scripts/pipeline/verify_repo_guide.py ]; then
  exit 0
fi

# Windows では python3 が Microsoft Store の実行エイリアスへ解決されても起動できないことがある。
# 候補を実際に動かして Python 3 であることを確認し、必要なら python へフォールバックする。
resolve_python3_command() {
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
      "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info.major == 3 else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

python_command=$(resolve_python3_command || true)
if [ -z "$python_command" ]; then
  echo "pre-commit: 実行可能な Python 3（python3 / python）が無いため、.meta とスキルミラーの検査をスキップします" >&2
  exit 0
fi

# 標準準拠検査を 1 回だけ走らせ、受け持つ検査の指摘だけを取り出す（他の検査は pre-push・CI・リリースゲートの担当）。
# Python は UTF-8 モードで動かす。Windows で PYTHONUTF8 を設定していないと、パイプへの出力が CP932 になって
# 下の日本語の grep が 1 件も一致せず、検査が黙って素通りする。
output=$(PYTHONUTF8=1 "$python_command" scripts/pipeline/verify_repo_guide.py 2>&1 || true)

if [ "$is_standard_template" -eq 1 ]; then
  template_errors=$(printf '%s\n' "$output" | grep '^ERROR 検査6:' || true)
  if [ -n "$template_errors" ]; then
    echo "" >&2
    echo "commit を中止しました: テンプレート正本の GUID の検査（検査 6）に落ちています。" >&2
    printf '%s\n' "$template_errors" >&2
    echo "テンプレート正本へ .meta はコミットできません。派生先の初回 Unity import に固有 GUID を生成させてください。" >&2
    echo "（.gitignore で無視される .meta と、自リポジトリが所有しない package の .meta は数えていません）" >&2
    echo "" >&2
    exit 1
  fi
fi

if [ "$has_skill_sync" -eq 1 ]; then
  mirror_errors=$(printf '%s\n' "$output" | grep '^ERROR 検査12:' || true)
  if [ -n "$mirror_errors" ]; then
    echo "" >&2
    echo "commit を中止しました: スキルのミラーが正本と一致していません。" >&2
    printf '%s\n' "$mirror_errors" >&2
    echo "" >&2
    echo "正本（pipeline/repo.json の skillSync.sourceRoots）を編集したあとは、" >&2
    echo "同じく skillSync.syncCommand に宣言した同期コマンドを実行してから commit してください。" >&2
    echo "" >&2
    exit 1
  fi
fi

exit 0
