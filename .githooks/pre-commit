#!/bin/sh
# 生成物: この内容はテンプレートリポジトリ UnityTemplate_2022_3_22f1 から配布されたコピーです。
# 編集はテンプレート側で行い、scripts/distribute_standard.py で再配布してください。
# source: UnityTemplate_2022_3_22f1/scripts/templates/githooks-pre-commit
# source-sha256: 1514cf22aeb020eb11f4e251d5df848e50b24a39b6d509e802208ab918d6a99c
# テンプレート GUID の流用と、スキルミラーの drift を commit 前に止める。
#
# **同期はしない（index も working tree も変更しない）。** 検査だけを行い、ずれていれば
# commit を止めて修復コマンドを案内する。commit の途中で index を書き換えると
# `git add -p` の部分ステージの意図と食い違い、`git commit -a` は未追跡ファイルを拾わないため、
# 「hook が直したつもりで実際は不整合が commit される」状態を作りうる（2026-07-29 設計判断）。
#
# 自動でミラーさせる層は .claude/settings.json の PostToolUse フック（正本を編集した直後に同期）。
# 最終的な保証は CI（.github/workflows/pipeline-verify.yml の標準準拠検査）が持つ。
# この hook はその中間にある、手元での早期検出。
#
# 有効化（クローンごとに 1 回。core.hooksPath は git 追跡できないため）:
#   git config core.hooksPath .githooks
#
# 注意: `git commit --no-verify` で素通りできる。だからこの hook を唯一の保証にはしない。

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f pipeline/repo.json ]; then
  exit 0
fi

# テンプレート正本だけは .meta を 1 件も持たない。派生先の初回 import で固有 GUID を生成する。
# find の対象を Unity のソース領域へ限定し、Library/PackageCache 等の生成物を巻き込まない。
if grep -Eq '"role"[[:space:]]*:[[:space:]]*"standard"' pipeline/repo.json 2>/dev/null; then
  template_meta=$(find Assets Packages -type f -name '*.meta' -print 2>/dev/null || true)
  if [ -n "$template_meta" ]; then
    echo "" >&2
    echo "commit を中止しました: テンプレート正本へ .meta はコミットできません。" >&2
    printf '%s\n' "$template_meta" >&2
    echo "派生先の初回 Unity import に固有 GUID を生成させてください。" >&2
    echo "" >&2
    exit 1
  fi
fi

# skillSync 宣言を持たないリポジトリでは、以降のミラー検査は行わない。
if ! grep -q '"skillSync"' pipeline/repo.json 2>/dev/null; then
  exit 0
fi

if [ ! -f scripts/pipeline/verify_repo_guide.py ]; then
  exit 0
fi

# Windows では python3 が Microsoft Store の実行エイリアスへ解決されても起動できないことがある。
# 候補を実際に動かして Python 3 であることを確認し、必要なら python へフォールバックする。
resolve_python3_command() {
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
      "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info.major == 3 else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

python_command=$(resolve_python3_command || true)
if [ -z "$python_command" ]; then
  echo "pre-commit: 実行可能な Python 3（python3 / python）が無いためスキルミラーの検査をスキップします" >&2
  exit 0
fi

# 検査 12 の指摘だけを取り出す（他の検査はリリースゲートと CI の担当）。
output=$("$python_command" scripts/pipeline/verify_repo_guide.py 2>&1 || true)
mirror_errors=$(printf '%s\n' "$output" | grep '^ERROR 検査12' || true)

if [ -n "$mirror_errors" ]; then
  echo "" >&2
  echo "commit を中止しました: スキルのミラーが正本と一致していません。" >&2
  printf '%s\n' "$mirror_errors" >&2
  echo "" >&2
  echo "正本（pipeline/repo.json の skillSync.sourceRoots）を編集したあとは、" >&2
  echo "同じく skillSync.syncCommand に宣言した同期コマンドを実行してから commit してください。" >&2
  echo "" >&2
  exit 1
fi

exit 0
